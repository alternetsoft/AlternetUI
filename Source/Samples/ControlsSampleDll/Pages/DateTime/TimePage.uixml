<Panel x:Class="ControlsSample.TimePage"
        xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml"
        xmlns:local="clr-namespace:ControlsSample;assembly=ControlsSample">
  <StackPanel Orientation="Vertical" Padding="10">
    <VerticalStackPanel>

        <HorizontalStackPanel Margin="5" Name="textBoxesPanel" MinChildMargin="5">
          <Label Text="Time:" Margin="0,0,0,0" IsTextLocalized="true" VerticalAlignment="Center"/>
          <TimePicker
            MinWidth="200" HorizontalAlignment="Left"
            Margin="10,0,0,0" Name="timePicker"
            ValueChanged="TimePicker_Changed"/>
          <Label Text="Selected:" Margin="10,0,0,0" Name="timeLabel" IsTextLocalized="true" VerticalAlignment="Center"/>
        </HorizontalStackPanel>

      <TabControl Name="tabControl2" Margin="10,5,5,5">

        <VerticalStackPanel Margin="5" Title="Options" MinChildMargin="5">
          <XCheckBox Name="showSecondsCheckBox" Margin="0,0,0,5" IsChecked="True"
                    Text="Show Seconds" IsTextLocalized="true"/>
          <Label Text="Hour Format:" Margin="0,0,0,5"/>
          <EnumPicker Name="hourFormatPicker" Margin="0,0,0,5" />

          <XButton Text="Set Now" Click="SetNow_Click" Margin="0,0,0,5" IsTextLocalized="true"
                  Name="buttonSetNow"/>
          <XButton Text="Has Border" Margin="0,0,0,5" Name="hasBorderButton" IsTextLocalized="true"
            Click="HasBorderButton_Click" Visible="true"/>

        </VerticalStackPanel>

      </TabControl>

    </VerticalStackPanel>
  </StackPanel>
</Panel>