<Panel x:Class="ControlsSample.DatePage"
        xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml"
        xmlns:local="clr-namespace:ControlsSample;assembly=ControlsSample">
    <VerticalStackPanel Padding="10" MinChildMargin="5">

      <HorizontalStackPanel Margin="5" Name="textBoxesPanel" MinChildMargin="5">
        <Label Text="Date:" IsTextLocalized="true" VerticalAlignment="Center"/>
        <DatePicker
          MinWidth="200" HorizontalAlignment="Left"
          Name="datePicker"
          ValueChanged="DatePicker_DateChanged" VerticalAlignment="Center"/>
        <Label Text="Selected:" Name="dateLabel" IsTextLocalized="true" VerticalAlignment="Center"/>
      </HorizontalStackPanel>

      <TabControl Name="tabControl2">

        <VerticalStackPanel Margin="5" Title="Actions" MinChildMargin="5" MaxWidth="300">
          <XButton Text="Date Formats" Margin="0,0,0,5" IsTextLocalized="true"
                  Name="buttonDateFormats"/>
          <XButton Text="Set Date/Time" Click="SetNow_Click" Margin="0,0,0,5" IsTextLocalized="true"
                  Name="buttonSetNow"/>
          <XButton Text="Set Date" Click="SetNowDate_Click" Margin="0,0,0,5" IsTextLocalized="true"
                  Name="buttonSetOnlyDate"/>
          <XButton Text="Has Border" Margin="0,0,0,5" Name="hasBorderButton" IsTextLocalized="true"
            Click="HasBorderButton_Click" Visible="true"/>
        </VerticalStackPanel>

        <VerticalStackPanel Margin="5" Title="Range" Padding="5" MinChildMargin="5" MaxWidth="300">
            <Label Text="Allow Date Range:" Margin="0,0,0,5"/>
            <XButton Text="Any Date" Margin="0,0,0,5" IsTextLocalized="true"
                    Click="RangeAnyDate_Click" Name="buttonAnyDate"/>
            <XButton Text="Allow &lt;= Tomorrow" Margin="0,0,0,5" IsTextLocalized="true"
                    Click="RangeTomorrow_Click" Name="buttonRangeTomorrow"/>
            <XButton Text="Allow &gt;= Yesterday" Margin="0,0,0,5" IsTextLocalized="true"
                    Click="RangeYesterday_Click" Name="buttonRangeYesterday"/>
            <XButton Text="Yesterday..Tomorrow" Margin="0,0,0,5" IsTextLocalized="true"
                    Click="RangeYesterdayTomorrow_Click" Name="buttonRangeYesterdayTomorrow"/>
        </VerticalStackPanel>

      </TabControl>

    </VerticalStackPanel>
</Panel>