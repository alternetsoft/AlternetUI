<Panel x:Class="ControlsSample.ButtonPage"
        xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml">
  <VerticalStackPanel>
  
    <VerticalStackPanel Padding="10" Grid.Row="0">

      <HorizontalStackPanel>

        <!-- ===================================== -->

        <Grid Margin="0,0,0,0" RowCount="4" ColumnCount="2" Name="propsContainer1">
          <Label Text="Text " Margin="5" Grid.Column="0" Grid.Row="0" IsTextLocalized="true"
                 VerticalAlignment="Center"/>
          <TextPicker Text="Test Button" Name="textTextBox" Margin="5" IsTextLocalized="true"
                   TextChanged="Button_Changed" Grid.Column="1" Grid.Row="0"/>

          <Label Text="Text Font" Name="labelFont" Margin="5" IsTextLocalized="true"
                 VerticalAlignment="Center"
                 Grid.Column="0" Grid.Row="1"/>
          <FontNamePicker Name="comboBoxFontName" Margin="5"
                     Grid.Column="1" Grid.Row="1"/>

          <Label Text="Text Size" Name="labelSize" IsTextLocalized="true"
                 Margin="5" VerticalAlignment="Center"
                 Grid.Column="0" Grid.Row="2"/>
          <FontSizePicker Width="5" Name="comboBoxFontSize"
                    Margin="5"  Grid.Column="1" Grid.Row="2"/>
        </Grid>

        <!-- ===================================== -->

        <Grid Margin="10,0,0,0" RowCount="4" ColumnCount="2" Name="propsContainer2">
          <Label Text="Align" VerticalAlignment="Center" Margin="5" IsTextLocalized="true"
                 Grid.Column="0" Grid.Row="0" />
          <EnumPicker Name="textAlignComboBox" Margin="5"
                    Grid.Column="1" Grid.Row="0" />

          <Label Text="Image" VerticalAlignment="Center" Margin="5" IsTextLocalized="true"
                 Grid.Column="0" Grid.Row="1" />
          <EnumPicker Name="imageAlignComboBox" Margin="5"
                    Grid.Column="1" Grid.Row="1"/>

          <XButton Text="Image Margins..." Name="imageMarginsButton"
                  RowIndex="3" ColumnIndex="0" IsTextLocalized="true"
                  ColumnSpan="2" Margin="5"/>
        </Grid>
      </HorizontalStackPanel>

      <HorizontalStackPanel Margin="5,0,0,0">
        <VerticalStackPanel Margin="0,0,0,0">
          <XCheckBox Text="Disabled" Name="disabledCheckBox" Margin="0,10,0,0" IsTextLocalized="true" />
          <XCheckBox Text="Image" Name="imageCheckBox" Margin="0,10,0,0"
                    IsChecked="True" IsTextLocalized="true" />
        </VerticalStackPanel>

        <VerticalStackPanel Margin="5,0,0,0">
          <XCheckBox Text="Default" Name="defaultCheckBox" Margin="0,10,0,0"  IsTextLocalized="true"/>
          <XCheckBox Text="Bold" Name="boldCheckBox" Margin="0,10,0,0"  IsTextLocalized="true"/>
        </VerticalStackPanel>

        <VerticalStackPanel Margin="5,0,0,0">
          <XCheckBox Text="Border" Name="hasBorderCheckBox" IsTextLocalized="true"
                    IsChecked="True" Margin="0,10,0,0" />
          <XCheckBox Text="TabStop" Name="tabStopCheckBox" IsTextLocalized="true"
                    IsChecked="True" Margin="0,10,0,0" />
        </VerticalStackPanel>

        <VerticalStackPanel Margin="5,0,0,0">
          <XCheckBox Text="Show Text" Name="showTextCheckBox" IsTextLocalized="true"
                    IsChecked="True" Margin="0,10,0,0" />
          <XCheckBox Text="Debug Corners" Name="debugCornersCheckBox"
                    IsChecked="False" Margin="0,10,0,0" />
          <XCheckBox Text="Exact Fit" IsChecked="False" IsTextLocalized="true"
                    Name="exactFitCheckBox" Margin="0,10,0,0" IsVisible="false" />
        </VerticalStackPanel>
      </HorizontalStackPanel>

    </VerticalStackPanel>

    <Panel Grid.Row="1" Margin="10" Layout="Horizontal" VerticalAlignment="Fill">
      <XButton Name="button" VerticalAlignment="Top"  IsTextLocalized="true" MarginTop="10"
              HorizontalAlignment="Center" Click="Button_Click"/>
      <XButton Name="button2" VerticalAlignment="Bottom" Text="Secondary Button"
              HorizontalAlignment="Right"/>
    </Panel>
  </VerticalStackPanel>
</Panel>