<Window xmlns="http://schemas.alternetsoft.com/ui/2021"
        xmlns:x="http://schemas.alternetsoft.com/ui/2021/uixml"
        x:Class="ApiDoc.StackPanelWindow"
        Title="Examples.StackPanel">
    <!-- <CreateUixmlDeclaration> -->
    <StackPanel Name="stackPanel" Margin="16,16,16,16" Orientation="Vertical">
      <XButton Text="Add Item" Name="addItemButton" Margin="8"/>
      <XButton Text="Remove Item" Name="removeItemButton" Margin="8"/>
      <XButton Text="Edit Item" Name="editItemButton" Margin="8" VerticalAlignment="Fill"/>
    </StackPanel>
    <!-- </CreateUixmlDeclaration> -->
</Window>
